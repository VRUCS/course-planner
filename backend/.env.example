# کپی کنید به .env و مقادیر را پر کنید
# cp backend/.env.example backend/.env

# ─── کلید API (اجباری) ───────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...

# توکن مستقل برای دسترسی frontend به endpointهای AI.
# یک مقدار تصادفی بلند بسازید؛ هرگز OPENROUTER_API_KEY را در frontend نگذارید.
AI_API_TOKEN=replace-with-a-long-random-token
ALLOW_ANONYMOUS_AI=false

# ─── مدل پیش‌فرض ─────────────────────────────────────────────────────────
DEFAULT_MODEL=deepseek/deepseek-chat-v3-0324
ALLOWED_MODELS=deepseek/deepseek-chat-v3-0324

# ─── Feature flag: فیچرهای interactive (chat، تحلیل بار، مسیریاب) ───────
# False = فقط batch endpoints فعالند (generate-rules، curriculum extraction)
# True  = همه endpoint ها فعالند
AI_INTERACTIVE_ENABLED=false

# ─── آدرس frontend (CORS) ─────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
# برای GitHub Pages، origin دقیق سایت را نیز اضافه کنید:
# FRONTEND_ORIGINS=https://USERNAME.github.io

# ─── تنظیمات سرور ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

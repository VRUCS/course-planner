# کپی کنید به .env و مقادیر را پر کنید
# cp backend/.env.example backend/.env

# ─── کلید API (اجباری) ───────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...

# ─── مدل پیش‌فرض ─────────────────────────────────────────────────────────
DEFAULT_MODEL=deepseek/deepseek-chat-v3-0324
ALLOWED_MODELS=deepseek/deepseek-chat-v3-0324

# ─── کلید روشن/خاموش AI (هیچ توکنی از کاربر گرفته نمی‌شود) ───────────────
# False = همه endpoint های /api/ai غیرفعال‌اند (503)
# True  = AI برای همه کاربران سایت فعال است (با rate limit هر IP)
AI_INTERACTIVE_ENABLED=false

# ─── آدرس frontend (CORS) ─────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
# برای GitHub Pages، origin دقیق سایت را نیز اضافه کنید:
# FRONTEND_ORIGINS=https://USERNAME.github.io

# ─── تنظیمات سرور ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
